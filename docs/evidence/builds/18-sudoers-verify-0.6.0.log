# command: visudo -c -f <staged allowlist>; visudo -c -f <stock sudoers + allowlist>
# env: LC_ALL=C; rootless (visudo -c only parses, it does not install)
# workdir: /mega/tmp/sm750/t9

# The stock /etc/sudoers is mode 0440 root:root and unreadable as coder, so the
# append test uses the sudo RPM payload instead. It is the same 4375 B file:
$ rpm2cpio /mega/tmp/sm750/t9/dl/sudo-1.9.17-7.p2.fc43.x86_64.rpm | cpio -idm
$ cp dl/etc/sudoers sudoers-combined.test; chmod u+w sudoers-combined.test
$ cat /mega/tmp/sm750/10-sm750-debug.sudoers >> sudoers-combined.test
$ wc -l sudoers-combined.test
188 sudoers-combined.test

=== colon audit: no ':' anywhere in a command line except the NOPASSWD: tag ===
$ grep -vE "^[[:space:]]*(#|$)" 10-sm750-debug.sudoers | sed "s/NOPASSWD://" | grep -c ":"
0   # grep exits 1 on zero matches; that is the pass condition here

